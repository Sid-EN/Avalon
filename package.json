{
  "name": "avalon-web",
  "private": true,
  "type": "module",
  "description": "阿瓦隆線上桌遊（GitHub Pages + Firebase Realtime Database）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build:rules": "node tools/build-rules.mjs",
    "build:site": "node tools/build-site.mjs",
    "check:syntax": "node tools/check-syntax.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:functional": "node --test \"tests/functional/**/*.test.mjs\"",
    "test:rules": "node --test --test-concurrency=1 \"tests/rules/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run check:syntax && npm run test:unit && npm run test:functional",
    "test:emulator": "firebase emulators:exec --only auth,database --project demo-avalon \"npm run test:rules && npm run test:e2e\"",
    "test:all": "npm test && npm run test:emulator"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.0"
  }
}
